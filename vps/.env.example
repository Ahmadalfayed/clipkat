# ===== كليب كات — ملف الإعدادات =====
# ينشئه install.sh تلقائياً (مع أسرار عشوائية). هذا مثال فقط — لا ترفعه لأي مكان عام.

# نطاقك (اختياري). إن تركته فارغاً يعمل الموقع على http://عنوان-السيرفر
DOMAIN=
# يتحول تلقائياً: النطاق إن وُجد، وإلا :80
SITE_ADDRESS=:80
# بريد لشهادة HTTPS (Let's Encrypt)
ACME_EMAIL=admin@example.com
# 1 عند استخدام HTTPS (نطاق)، 0 عند HTTP على IP
COOKIE_SECURE=0

# حساب المشرف (يُنشأ عند أول تشغيل ثم تُمسح كلمة المرور من هذا الملف)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# أقصى حجم لمقطع الفيديو بالميغابايت
MAX_VIDEO_MB=500
MAX_BODY=520MB

# أسرار تُولَّد تلقائياً — لا تشاركها
DB_PASSWORD=
JWT_SECRET=

# Webhook الدفع (اتركه فارغاً = معطّل). انظر server/README.md
WEBHOOK_SECRET=

# اختياري: مواقع أخرى مسموح لها بطلب الـ API (مفصولة بفواصل)
CORS_ORIGINS=

# معرّف عميل Google (OAuth 2.0 Web client). إن تُرك فارغاً يُخفى زر «المتابعة بحساب Google».
# Authorized JavaScript origins: https://clipkat.live و https://www.clipkat.live
GOOGLE_CLIENT_ID=

# تجهيز المقاطع لكل المتصفحات (تحويل HEVC/WebM/HDR إلى MP4 H.264 في الخلفية، مهمة واحدة في كل مرة)
TRANSCODE=1
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=23
TRANSCODE_THREADS=2
