# ===== كليب كات — ملف الإعدادات =====
# ينشئه install.sh تلقائياً (مع أسرار عشوائية). هذا مثال فقط — لا ترفعه لأي مكان عام.

# نطاقك (اختياري). إن تركته فارغاً يعمل الموقع على http://عنوان-السيرفر
DOMAIN=
# يتحول تلقائياً: النطاق إن وُجد، وإلا :80
SITE_ADDRESS=:80
# بريد لشهادة HTTPS (Let's Encrypt)
ACME_EMAIL=admin@example.com
# 1 عند استخدام HTTPS (نطاق)، 0 عند HTTP على IP
COOKIE_SECURE=0

# حساب المشرف (يُنشأ عند أول تشغيل ثم تُمسح كلمة المرور من هذا الملف)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# أقصى حجم لمقطع الفيديو بالميغابايت
MAX_VIDEO_MB=500
MAX_BODY=520MB

# أسرار تُولَّد تلقائياً — لا تشاركها
DB_PASSWORD=
JWT_SECRET=

# Webhook الدفع (اتركه فارغاً = معطّل). انظر server/README.md
WEBHOOK_SECRET=

# اختياري: مواقع أخرى مسموح لها بطلب الـ API (مفصولة بفواصل)
CORS_ORIGINS=

# معرّف عميل Google (OAuth 2.0 Web client). إن تُرك فارغاً يُخفى زر «المتابعة بحساب Google».
# Authorized JavaScript origins: https://clipkat.live و https://www.clipkat.live
GOOGLE_CLIENT_ID=

# تجهيز المقاطع لكل المتصفحات (تحويل HEVC/WebM/HDR إلى MP4 H.264 في الخلفية، مهمة واحدة في كل مرة)
TRANSCODE=1
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=23
TRANSCODE_THREADS=2

# البث المباشر والمكالمات (LiveKit ذاتي الاستضافة — انظر livekit/livekit.yaml)
# اتركها فارغة لتعطيل الميزتين. LIVEKIT_API_SECRET سر طويل عشوائي (openssl rand -hex 32).
COMPOSE_PROFILES=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=

# ---- العملات وهدايا البث المباشر (مصدر ربح المنصة الوحيد؛ مبيعات المتاجر بلا عمولة) ----
# demo = وضع تجريبي: الشحن مجاني للتجربة ولا يُخصم أي مبلغ حقيقي.
# لاحقاً: myfatoorah أو tap (KNET) بعد إكمال الربط في server/src/coin-payments.js ووضع المفاتيح أدناه.
PAYMENT_PROVIDER=demo
# نصيب المنصة من كل هدية (٪)
GIFT_PLATFORM_SHARE=50
# قيمة الألماسة عند السحب (د.ك)
DIAMOND_VALUE_KWD=0.0025
# أقل سحب (2000 × 0.0025 = 5 د.ك)
PAYOUT_MIN_DIAMONDS=2000
# سقف الشحن التجريبي لكل مستخدم يومياً
DEMO_COINS_DAILY_MAX=20000

# ===== تنزيل المقاطع واشتراك «كليب كات بلس» =====
# سعر الاشتراك الشهري (30 يوماً) للتنزيل بدون شعار، بالدينار — يُدفع عبر PAYMENT_PROVIDER (تجريبي حالياً)
PLUS_MONTHLY_KWD=0.500
# أو بالعملات من المحفظة (تذهب العملات إيراداً للمنصة)
PLUS_MONTHLY_COINS=170
# حد طلبات التنزيل لكل مستخدم في 10 دقائق
DOWNLOAD_RATE_MAX=30
# مثال: https://clipkat.live (لروابط العودة من بوابة الدفع)
PUBLIC_URL=
MYFATOORAH_API_KEY=
# https://api.myfatoorah.com أو https://apitest.myfatoorah.com
MYFATOORAH_BASE_URL=
TAP_SECRET_KEY=

# ===== البريد: «نسيت كلمة السر؟» (استعادة كلمة المرور) =====
# PUBLIC_URL أعلاه مطلوب لبناء رابط الاستعادة (مثال: https://clipkat.live)
MAIL_FROM=no-reply@clipkat.live
MAIL_FROM_NAME=كليب كات
# الطريقة 1 (مجانية): إرسال مباشر من الخادم موقّع DKIM — يحتاج المنفذ 25 الصادر مفتوحاً وسجلات DNS:
#   A     mail                  → عنوان IP للخادم (وسجل PTR للخادم = mail.النطاق)
#   TXT   @                     → v=spf1 ip4:<IP> -all
#   TXT   <selector>._domainkey → v=DKIM1; k=rsa; p=<المفتاح العام>
#   TXT   _dmarc                → v=DMARC1; p=none; adkim=r; aspf=r
# والمفتاح الخاص في data/dkim/private.pem (مقروء للمستخدم 1000)
MAIL_DIRECT=0
MAIL_HELO=mail.clipkat.live
DKIM_DOMAIN=clipkat.live
DKIM_SELECTOR=ck1
# الطريقة 2: خادم SMTP خارجي (له الأولوية إن ضُبط)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
# حدود الطلبات: لكل IP كل 15 دقيقة، ولكل بريد كل ساعة
RESET_RATE_IP_MAX=5
RESET_RATE_EMAIL_MAX=3

# ===== استقبال البريد: support@النطاق → بريدك (خدمة mx) =====
# فعّلها بإضافة mail إلى COMPOSE_PROFILES (مثال: COMPOSE_PROFILES=live,mail) وسجل DNS:  MX  @  → mail.النطاق (أولوية 10)
# العنوان=الوجهة، ويمكن أكثر من عنوان مفصولة بفاصلة
MX_ROUTES=support@clipkat.live=you@gmail.com
MX_MAX_MB=15
MX_RATE_PER_HOUR=30
