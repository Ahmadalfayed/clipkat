<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/ckBackground</item>
        <item name="colorPrimaryDark">@color/ckBackground</item>
        <item name="colorAccent">@color/ckPrimary</item>
        <item name="android:windowBackground">@color/ckBackground</item>
        <item name="android:statusBarColor">@color/ckBackground</item>
        <item name="android:navigationBarColor">@color/ckBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ckBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ckBackground</item>
        <item name="android:navigationBarColor">@color/ckBackground</item>
    </style>
</resources>
